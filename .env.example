# ─────────────────────────────────────────────────────────────
#  API connection — change ONLY this file to switch environments
# ─────────────────────────────────────────────────────────────
# Which API the site talks to:  test  |  production
NEXT_PUBLIC_API_MODE=test

# Base URL of the booking API (no trailing slash, no /api/v1 — that is added automatically)
NEXT_PUBLIC_API_URL_TEST=http://localhost:4000
NEXT_PUBLIC_API_URL_PRODUCTION=https://api.yourdomain.com

# ─────────────────────────────────────────────────────────────
#  Site settings
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=ALICE_VIP_TRANSFERS

# Optional: only show rates that carry this agent tag (leave empty to show every rate).
# A visitor can override it per link:  https://book.yourdomain.com/?tag=omar
NEXT_PUBLIC_DEFAULT_RATE_TAG=ALICE_VIP_TRANSFERS

# Agent addresses the customer website is allowed to name via NEXT_PUBLIC_AGENT_EMAIL, even if that agent
# has no account in this system (comma-separated). Registered, verified agents are always allowed.
ALLOWED_AGENT_EMAILS=anumjawaid.work@gmail.com

NEXT_PUBLIC_AGENT_EMAIL=anumjawaid.work@gmail.com
# Optional: email of the agent who should receive the bookings made on this site.
# The API only accepts it if it belongs to a registered, verified agent, and then assigns the booking
# (and the agent email) to that agent. Leave empty to let the API rotate bookings between agents.
# NOTE: NEXT_PUBLIC_ values are visible to anyone who views the page source.
NEXT_PUBLIC_AGENT_EMAIL=anumjawaid.work@gmail.com
# ─────────────────────────────────────────────────────────────
#  Agent for this website (optional)
# ─────────────────────────────────────────────────────────────
# Every booking made on this site is sent to the API together with these two values, and the API emails
# this agent and stores their details on the booking.
# The API only accepts the email if it is a registered agent OR is listed in the API's ALLOWED_AGENT_EMAILS
# (so nobody can use your account to email strangers). Leave both empty to let the API rotate agents.
# NOTE: NEXT_PUBLIC_ values are visible to anyone who views the page source.
NEXT_PUBLIC_AGENT_EMAIL=anumjawaid.work@gmail.com
NEXT_PUBLIC_AGENT_NAME=Anum_TEST_AGENT