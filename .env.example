# ─────────────────────────────────────────────────────────────
#  API connection — change ONLY this file to switch environments
# ─────────────────────────────────────────────────────────────
# Which API the site talks to:  test  |  production
NEXT_PUBLIC_API_MODE=test

# Base URL of the booking API (no trailing slash, no /api/v1 — that is added automatically)
NEXT_PUBLIC_API_URL_TEST=http://localhost:4000
NEXT_PUBLIC_API_URL_PRODUCTION=https://api.yourdomain.com

# ─────────────────────────────────────────────────────────────
#  Site settings
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=ALICE_VIP_TRANSFERS

# Optional: only show rates that carry this agent tag (leave empty to show every rate).
# A visitor can override it per link:  https://book.yourdomain.com/?tag=omar
NEXT_PUBLIC_DEFAULT_RATE_TAG=ALICE_VIP_TRANSFERS
